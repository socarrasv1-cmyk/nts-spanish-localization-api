# NTS Localization API V2.2 Configuration

# Bearer token for API authentication (set this to a strong random value)
NTS_API_KEY=your-secret-api-key-here

# Artifact retention time in hours
NTS_ARTIFACT_TTL_HOURS=168

# Request safeguards (GPT Actions allow less than 100,000 characters)
NTS_MAX_BODY_BYTES=95000
NTS_RATE_LIMIT_PER_MINUTE=120

# Allowed domains for localization (comma-separated)
NTS_ALLOWED_DOMAINS=www.heavyequipmenttransport.com,heavyequipmenttransport.com,nationwidetransportservices.com,www.nationwidetransportservices.com

# Data directory (local development)
NTS_DATA_DIR=./data

# Git staging repository path
NTS_GIT_REPO_PATH=./data/git-repo

# Git remote configuration
NTS_GIT_REMOTE_NAME=origin
NTS_GIT_DEFAULT_BASE_BRANCH=main
NTS_GIT_AUTHOR_NAME=NTS Spanish Translator
NTS_GIT_AUTHOR_EMAIL=localization@nationwidetransportservices.com

# Git push safety (false by default; enable only after verification)
NTS_GIT_PUSH_ENABLED=false

# Git provider (github)
NTS_GIT_PROVIDER=github

# Optional GitHub integration (set only when push/PR features are enabled)
# NTS_GITHUB_TOKEN=your-github-token-here
# NTS_GITHUB_REPOSITORY=socarrasv1-cmyk/nts-spanish-localization-api
