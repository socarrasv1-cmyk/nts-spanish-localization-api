{
  "openapi": "3.1.0",
  "info": {
    "title": "NTS Localization API V2.1",
    "version": "2.1.0",
    "description": "FastAPI for NTS Spanish Intelligence Hub — Staging-only localization, validation, Translation Memory approval, and Git staging",
    "contact": {
      "name": "NTS Support",
      "url": "https://www.nationwidetransportservices.com"
    }
  },
  "servers": [
    {
      "url": "https://nts-spanish-localization-api.onrender.com",
      "description": "Live Render staging endpoint"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token (NTS_API_KEY environment variable)"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "nts-localization-api"
          },
          "version": {
            "type": "string",
            "example": "2.1.0"
          }
        }
      },
      "ValidationResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["PASS", "FAIL", "REVIEW"]
              },
              "blocking": {
                "type": "boolean"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "metrics": {
                "type": "object"
              }
            }
          }
        }
      },
      "QAResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "QA score (0-100). READY requires >= 95."
              },
              "status": {
                "type": "string",
                "enum": ["READY", "NEEDS_REVIEW", "BLOCKED"],
                "description": "Publication status. READY: score >= 95 AND zero blockers. BLOCKED: any blocking failure."
              },
              "blocking_issues": {
                "type": "array",
                "description": "List of blocking issues that prevent publication"
              },
              "checks": {
                "type": "object",
                "description": "Individual validator results"
              }
            }
          }
        }
      },
      "TranslationMemoryEntry": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "example": "Start Quote"
          },
          "translation": {
            "type": "string",
            "example": "Iniciar cotización"
          },
          "site_id": {
            "type": "string",
            "nullable": true,
            "description": "null = global entry, specific site_id = site-specific override (preferred)"
          },
          "component": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "example": "es-US"
          },
          "approved": {
            "type": "boolean",
            "description": "true = human-approved canonical TM entry"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Proposal": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "approved", "rejected"],
            "description": "Proposal workflow status"
          },
          "site_id": {
            "type": "string",
            "nullable": true
          },
          "component": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reviewer": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Site": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string",
            "example": "HET"
          },
          "name": {
            "type": "string",
            "example": "Heavy Equipment Transport"
          },
          "brand": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "registry_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "URLMapping": {
        "type": "object",
        "properties": {
          "source_url": {
            "type": "string",
            "example": "/services/break-bulk-transport.php"
          },
          "spanish_url": {
            "type": "string",
            "example": "/es/servicios/transporte-de-carga-fraccionada.php"
          },
          "site_id": {
            "type": "string",
            "example": "HET"
          },
          "approved": {
            "type": "boolean",
            "description": "true = canonicalized and approved for use"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "description": "Verify API is responding. No authentication required.",
        "security": [],
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/sites": {
      "get": {
        "operationId": "listVerifiedSites",
        "summary": "List verified NTS sites",
        "description": "Returns all sites registered in the verified site registry.",
        "tags": ["Sites"],
        "responses": {
          "200": {
            "description": "List of verified sites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Site"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/url-map/approved": {
      "get": {
        "operationId": "getApprovedURLMapping",
        "summary": "Get approved Spanish URL mapping",
        "description": "Lookup the approved Spanish target for a given source URL on a specific site.",
        "tags": ["URL Mapping"],
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "HET"
          },
          {
            "name": "source_url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "/services/break-bulk-transport.php"
          }
        ],
        "responses": {
          "200": {
            "description": "Approved mapping found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/URLMapping"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No approved mapping found"
          }
        }
      }
    },
    "/v2/url-map/validate": {
      "post": {
        "operationId": "validateSpanishURLCandidate",
        "summary": "Validate Spanish URL candidate",
        "description": "Test a Spanish URL candidate against structural, PHP, and other validators. Does not auto-approve—approval is a separate step.",
        "tags": ["URL Validation"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "site_id": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string"
                  },
                  "candidate": {
                    "type": "string"
                  }
                },
                "required": ["site_id", "source_url", "candidate"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/validate/php": {
      "post": {
        "operationId": "validatePHPSyntax",
        "summary": "Validate PHP syntax",
        "description": "Run PHP lint on provided PHP code snippet.",
        "tags": ["Validators"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "php_code": {
                    "type": "string"
                  }
                },
                "required": ["php_code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PHP validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/validate/structure": {
      "post": {
        "operationId": "validateDOMStructure",
        "summary": "Validate DOM structure parity",
        "description": "Check that source and target HTML have equivalent DOM structure.",
        "tags": ["Validators"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_html": {
                    "type": "string"
                  },
                  "target_html": {
                    "type": "string"
                  }
                },
                "required": ["source_html", "target_html"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structure validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/validate/protected-tokens": {
      "post": {
        "operationId": "validateProtectedTokens",
        "summary": "Validate protected tokens preserved",
        "description": "Ensure PHP variables, constants, IDs, contact info, and other protected tokens are preserved in target.",
        "tags": ["Validators"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_content": {
                    "type": "string"
                  },
                  "target_content": {
                    "type": "string"
                  },
                  "token_patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["source_content", "target_content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Protected token validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/validate/english-residue": {
      "post": {
        "operationId": "validateEnglishResidue",
        "summary": "Validate no English residue",
        "description": "Scan target for untranslated English phrases, brand names, and other text that should be in Spanish.",
        "tags": ["Validators"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target_content": {
                    "type": "string"
                  }
                },
                "required": ["target_content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "English residue scan result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/validate/schema": {
      "post": {
        "operationId": "validateSchema",
        "summary": "Validate JSON-LD/schema markup",
        "description": "Check schema.org markup, canonical tags, hreflang, internal links.",
        "tags": ["Validators"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "html_content": {
                    "type": "string"
                  }
                },
                "required": ["html_content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schema validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/validate/links": {
      "post": {
        "operationId": "validateLinks",
        "summary": "Validate links and references",
        "description": "Verify all links point to valid targets and canonical/hreflang are correct.",
        "tags": ["Validators"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "site_id": {
                    "type": "string"
                  },
                  "html_content": {
                    "type": "string"
                  }
                },
                "required": ["site_id", "html_content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Link validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/qa/page": {
      "post": {
        "operationId": "runPageQA",
        "summary": "Run page QA",
        "description": "Run full QA suite on a page (PHP, structure, tokens, English, schema, links). Returns score 0-100. READY requires >= 95 AND zero blockers.",
        "tags": ["QA"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "site_id": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string"
                  },
                  "target_url": {
                    "type": "string"
                  },
                  "source_html": {
                    "type": "string"
                  },
                  "target_html": {
                    "type": "string"
                  }
                },
                "required": ["site_id", "source_url", "target_url", "source_html", "target_html"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Page QA result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QAResult"
                }
              }
            }
          }
        }
      }
    },
    "/v2/qa/batch": {
      "post": {
        "operationId": "runBatchQA",
        "summary": "Run batch QA",
        "description": "Run QA on multiple pages. Returns aggregate score and per-page results.",
        "tags": ["QA"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "site_id": {
                    "type": "string"
                  },
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source_url": {
                          "type": "string"
                        },
                        "target_url": {
                          "type": "string"
                        },
                        "source_html": {
                          "type": "string"
                        },
                        "target_html": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "required": ["site_id", "pages"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch QA result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/tm/search": {
      "get": {
        "operationId": "searchTranslationMemory",
        "summary": "Search Translation Memory",
        "description": "Find approved translations by source term, locale, site_id, or component.",
        "tags": ["Translation Memory"],
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Start Quote"
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "es-US"
          },
          {
            "name": "site_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "nullable": true
          },
          {
            "name": "component",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Translation Memory entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TranslationMemoryEntry"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/tm/propose": {
      "post": {
        "operationId": "submitTranslationProposal",
        "summary": "Submit translation proposal",
        "description": "Propose a new or updated translation. Does not auto-approve; must pass approval workflow.",
        "tags": ["Translation Memory"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "translation": {
                    "type": "string"
                  },
                  "site_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "component": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  },
                  "locale": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": ["source", "translation", "component", "locale"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Proposal created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Proposal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/tm/approve/{proposal_id}": {
      "post": {
        "operationId": "approveTranslationProposal",
        "summary": "Approve translation proposal",
        "description": "Accept a proposal and add it to approved Translation Memory.",
        "tags": ["Translation Memory"],
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proposal approved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Proposal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/tm/reject/{proposal_id}": {
      "post": {
        "operationId": "rejectTranslationProposal",
        "summary": "Reject translation proposal",
        "description": "Decline a proposal. It will not be added to Translation Memory.",
        "tags": ["Translation Memory"],
        "parameters": [
          {
            "name": "proposal_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proposal rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Proposal"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
