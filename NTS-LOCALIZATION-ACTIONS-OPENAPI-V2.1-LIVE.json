    "/v2/git/stage": {
      "post": {
        "operationId": "stageTranslationFiles",
        "summary": "Write READY translation files to staging and commit",
        "description": "Stage only after QA has returned READY status.",
        "tags": ["Git Staging"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "branch_name": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "example": "es/servicios/transporte.php"
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "commit_message": {
                    "type": "string",
                    "example": "Localize transport pages (QA READY)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Files staged and committed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "branch": {
                          "type": "string"
                        },
                        "files_staged": {
                          "type": "integer"
                        },
                        "commit_message": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["committed"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Git staging error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2/git/push": {
      "post": {
        "operationId": "pushTranslationBranch",
        "summary": "Push an existing translation branch",
        "description": "Only available when NTS_GIT_PUSH_ENABLED=true (requires explicit approval before deployment). Returns 400 if push is disabled.",
        "tags": ["Git Staging"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "branch_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Branch pushed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "branch": {
                          "type": "string"
                        },
                        "remote": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["pushed"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Push is disabled (NTS_GIT_PUSH_ENABLED=false in staging)"
